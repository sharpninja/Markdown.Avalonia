<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <PackageTargetFrameworks>net461;netstandard2.0;net6</PackageTargetFrameworks>
    <DemoAppTargetFrameworks>net461;netcoreapp3.1;net6;net7</DemoAppTargetFrameworks>
    <TestTargetFrameworks>net6</TestTargetFrameworks>
  </PropertyGroup>

  <!-- Linux/WSL fallback: ensure target frameworks are defined so restore/build graph is valid. -->
  <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
    <PackageTargetFrameworks>netstandard2.0;net6</PackageTargetFrameworks>
    <DemoAppTargetFrameworks>net6;net7</DemoAppTargetFrameworks>
    <TestTargetFrameworks>net6</TestTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(IS_WHISTYUN_PC)' == 'Y' ">
    <TestTargetFrameworks>netcoreapp3.1;net5;net6;net7</TestTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 11.2.6+ has fix for CompileAvaloniaXamlTask original.pdb lock (Avalonia#12670) -->
    <AvaloniaVersion>11.3.12</AvaloniaVersion>
    <DemoAvaloniaVersion>11.0.5</DemoAvaloniaVersion>
    <EnableAvaloniaEdit>enabled</EnableAvaloniaEdit>
    <AvaloniaEditVersion>11.0.0</AvaloniaEditVersion>
    <AvaloniaSvgVersion>11.0.0</AvaloniaSvgVersion>
    <NoWarn>$(NoWarn);NU1605;NETSDK1138</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);MSB3277</WarningsNotAsErrors>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Ignore temporary build output folders created inside project roots. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;artifacts\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(AVA_VER)' != '' ">
    <TestAvaloniaVersion>$(AVA_VER)</TestAvaloniaVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(AVA_VER)' == '' ">
    <TestAvaloniaVersion>$(AvaloniaVersion)</TestAvaloniaVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageVersion>11.0.3-a1</PackageVersion>
  </PropertyGroup>

</Project>
